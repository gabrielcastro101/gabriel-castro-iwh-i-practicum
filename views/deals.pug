doctype html
html 
    head 
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Deals
        .cards 
            each deal in data
                .card 
                    h2.card__name #{deal.properties.name}
                    p Deal Amount: #{deal.properties.bio}
                    p Deal Stage: #{deal.properties.age}